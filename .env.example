# Qloo hackathon key (request it from the Qloo hackathon developer guide). Only works against the hackathon base URL.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Any OpenAI-compatible chat endpoint that supports tool calling.
# Example for Google Gemini (free tier): https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
